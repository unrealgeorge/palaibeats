# --- Required ---

# Your Discord bot token (Discord Developer Portal -> Bot -> Reset Token).
# Never commit the real value.
DISCORD_TOKEN=

# The Discord server (guild) ID this bot is deployed to.
# PalaiBeats is designed for a single server. Enable Developer Mode in
# Discord (User Settings -> Advanced) to copy a server ID by right-clicking it.
GUILD_ID=

# --- Optional (sensible defaults shown) ---

# Name of the Discord role that is allowed to control playback
# (play/skip/stop/volume/radio management). Create a role with this
# exact name in your server and assign it to whoever should be a DJ.
# Server admins/owner can always control the bot regardless of this role.
DJ_ROLE_NAME=DJ

# Path (inside the container) where your local music library lives.
# Mount your real music folder here via docker-compose (see MUSIC_PATH below).
MUSIC_ROOT=/music

# Path (inside the container) to the SQLite database file.
DB_PATH=/data/palaibeats.db

# Default playback volume, 0.0 - 2.0 (1.0 = 100%).
DEFAULT_VOLUME=0.5

# Seconds of being alone in a voice channel before the bot auto-disconnects.
# Set to 0 to disable.
IDLE_TIMEOUT_SECONDS=300

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# If set, PalaiBeats exposes a tiny HTTP health endpoint on this port
# (GET /healthz -> 200 OK) for Docker healthchecks / uptime monitoring.
# Leave empty to disable.
HEALTH_CHECK_PORT=8181

# --- docker-compose only (host side, not read by the bot itself) ---

# Absolute path on your Raspberry Pi to the folder containing your music,
# organized as subfolders per artist/category, e.g.:
#   MUSIC_PATH/Artist A/song1.mp3
#   MUSIC_PATH/Artist A/song2.mp3
#   MUSIC_PATH/Some Playlist/song3.flac
MUSIC_PATH=./music
